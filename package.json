{
  "name": "trischach",
  "version": "1.6.0",
  "description": "3-player hexagonal chess with RPS mechanics",
  "main": "js/main.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/copy-assets.mjs",
    "check:js": "tsc --noEmit --skipLibCheck --allowJs --checkJs --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "happy-dom": "^20.11.12",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bumblei3/trischach.git"
  },
  "keywords": [],
  "author": "",
  "license": "WTFPL",
  "bugs": {
    "url": "https://github.com/bumblei3/trischach/issues"
  },
  "homepage": "https://github.com/bumblei3/trischach#readme"
}
