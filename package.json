{
  "name": "trischach",
  "version": "1.7.0",
  "description": "3-player hexagonal chess with RPS mechanics",
  "main": "js/main.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "npx tsx scripts/engine-strength.ts",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/copy-assets.mjs",
    "check:js": "tsc --noEmit --skipLibCheck --allowJs --checkJs --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bumblei3/trischach.git"
  },
  "keywords": [],
  "author": "",
  "license": "WTFPL",
  "bugs": {
    "url": "https://github.com/bumblei3/trischach/issues"
  },
  "homepage": "https://github.com/bumblei3/trischach#readme",
  "engines": {
    "node": ">=24 <25"
  }
}
